# ========================
# 本地网络（必须）
# ========================
# Windows 系统代理（Clash 等）会被 httpx 读到并劫持 localhost 请求，
# 导致 Ollama 返回 502。这里强制本地回环直连。
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1


# ========================
# 主模型（Ollama）
# ========================
# provider 四选一：zhipu | deepseek | qwen | ollama
# 以下各项均为必需项；缺失时 require_env() 会直接报错并指出变量名，
# 不会静默回退到别的厂商。
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

SUPERVISOR_PROVIDER=ollama
SUPERVISOR_MODEL=qwen2.5:7b-instruct-q4_K_M

FACT_AGENT_PROVIDER=ollama
FACT_AGENT_MODEL=qwen2.5:7b-instruct-q4_K_M

CONTRACT_AGENT_PROVIDER=ollama
CONTRACT_AGENT_MODEL=qwen2.5:7b-instruct-q4_K_M


# ========================
# 后台任务模型（走 Ollama）
# ========================
# 记忆提取：后台任务、每轮都跑、不阻塞对话 → 用轻量 3B。
MEMORY_EXTRACTOR_MODEL=qwen2.5:3b-instruct-q4_K_M
# 上下文压缩：阻塞当轮回复、低频触发，但输出写入长期记忆并逐轮回灌改写，
# 抽取错误会累积 → 用 7B 保证 JSON schema 与案件实体抽取质量。
# 留空时会自动回退到 MEMORY_EXTRACTOR_MODEL。
CONTEXT_COMPACTION_MODEL=qwen2.5:7b-instruct-q4_K_M


# ========================
# Embedding（检索 / 长期记忆，走 Ollama）
# ========================
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_KEY=ollama
EMBEDDING_BATCH_SIZE=64
# bge-m3 不需要查询指令前缀
EMBEDDING_QUERY_PREFIX=


# ========================
# 检索与精排
# ========================
# 精排后端：llm（走 Ollama，无需本地模型）/ cross_encoder（需 models/bge-reranker-base）
# 实测：bge-m3 余弦无法区分相关与无关（无关 query 也能到 0.65+），
# 因此精排不能关，否则 low_quality 联网兜底会失效。
RERANKER_ENABLED=true
RERANKER_BACKEND=llm
RERANKER_LLM_MAX_CANDIDATES=20
RERANKER_LLM_TIMEOUT=60
# 精排模型可单独指定；留空则复用 LLM_MODEL
# RERANKER_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

RETRIEVER_TOP_K=20
# 精排分数阈值（相关≈1.0 / 不相关≈0.0）
RERANKER_SCORE_THRESHOLD=0.3
# 仅 RERANKER_ENABLED=false 时生效，量纲是语义余弦相似度
RETRIEVER_SCORE_THRESHOLD=0.45
RRF_K=60
MAX_TOOL_CALLS=4


# ========================
# HyDE
# ========================
HYDE_ENABLED=true
HYDE_MODEL=qwen2.5:7b-instruct-q4_K_M
HYDE_LLM_BASE_URL=http://localhost:11434/v1
HYDE_REWRITE_ENABLED=true


# ========================
# 配额 / 缓存 / 管理端
# ========================
# 每日配额，0 表示不限制
LEGAL_DAILY_REQUEST_LIMIT=200
LEGAL_DAILY_TOKEN_LIMIT=200000

RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=3600
# 设置后 /api/admin/* 需要请求头 X-Admin-Key
# ADMIN_API_KEY=change-me


# ========================
# 存储路径
# ========================
CHECKPOINT_DB=data/checkpoints.sqlite
DOCS_DB=data/docs.sqlite
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10


# ========================
# 可选：云端 Provider
# ========================
# 切到 zhipu / deepseek / qwen 时需填对应 key
# ZHIPU_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# DASHSCOPE_API_KEY=sk-xxx
# LLM_BASE_URL_OVERRIDE=http://192.168.1.50:11434/v1
# LLM_FALLBACK_PROVIDERS=deepseek,qwen
# HyDE 单独走远端 endpoint 时的 key（留空则复用上面的）
# HYDE_API_KEY=sk-xxx

# 动态模型路由（可选）：不配置时按上面 provider/model 走；
# 配置后按任务复杂度在 fast/strong/long 之间选择。
# LLM_ROUTE_FAST_PROVIDER=ollama
# LLM_ROUTE_FAST_MODEL=qwen2.5:3b-instruct-q4_K_M
# LLM_ROUTE_STRONG_PROVIDER=ollama
# LLM_ROUTE_STRONG_MODEL=qwen2.5:7b-instruct-q4_K_M
# LLM_ROUTE_LONG_PROVIDER=ollama
# LLM_ROUTE_LONG_MODEL=qwen2.5:7b-instruct-q4_K_M

# 联网搜索兜底（可选）：不配置时使用 DuckDuckGo
# TAVILY_API_KEY=tvly-xxx
